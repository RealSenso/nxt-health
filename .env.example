# Frontend build settings. In GitHub, add these as repository *variables* (they are public web config, not secrets).
VITE_API_URL=https://nxt-health-api.onrender.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# Local development only: leave the Firebase values empty to use the Auth emulator automatically.
